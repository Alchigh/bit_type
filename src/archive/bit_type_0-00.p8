pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
player_name=""
letters="abcdefghijklmnopqrstuvwxyz"
letter=""
counter = 0
lcolor = 7
timer = 0

function _init()
 poke(0x5f2d,1)
 new_letter()
end

function new_letter()
	letter=chr(flr(rnd(26))+97)
	lcolor=7
end

function _update()
	--disable pause via p or enter
	poke(0x5f30,1)
	timer += 1
	
 if stat(30) then
  local c = stat(31)
  if c == letter then
  	player_name..= c
  	new_letter()
  else
   lcolor = 8
  end
  
  --backspace detection  
  if c == "\b" then 
   player_name = sub(player_name,1,#player_name-2)
  end
  
  
  if (#player_name) == 10 then
  	player_name = ""
  	counter += 10
  end
 end
end

function _draw()
 cls()
 print("count:"..tostr(counter),0,0,6)
 print("seconds: "..flr(timer/30), 0, 100, 7)
 print("name:",10,10,7)
 print(player_name,10,20,11)
	print(letter,50,50,lcolor)
end
