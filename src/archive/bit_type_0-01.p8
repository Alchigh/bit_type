pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
typed=""
letters="abcdefghijklmnopqrstuvwxyz"
letter=""
topl = ""
word = ""

fox = "the quick brown fox"
fox_p = 63
ch = ""

-- timer variables
lcolor = 7
test_time = 60
timer = 0
tick = 0
game_over = false


--wmp & acc variable
correct_char = 0
wrong_char = 0
wpm = 0
acc = 100
index = 1

function _init(x)
 poke(0x5f2d,1) --enable stat(31)
 poke(0x5f2e,1) --hidden palette
 pal(9,9+122,1)
 palt(0,false)
 palt(5,true)
 reset_game()
 
 topl = sub(fox,index,index)
 test_time = max(15,x)
	timer = 0
end

function _update60()
	if game_over == true then
	 return 
	end
	
	tick += 1
		--disable pause via p or enter
	poke(0x5f30,1)
	
 if stat(30) then
  local c = stat(31) -- last typed character
    
  if c == topl then
  	typed..= c
  	index += 1
  	fox_p -= 4-- move text to left
  	correct_char += 1
  	ch = ""
  	lcolor = 7
 
  --backspace detection
  elseif c == "\b" and fox_p < 64 then 
   typed = sub(typed,1,#typed-1)
   index -= 1
   fox_p += 4
   
  else  -- if wrong letter typed
   lcolor = 8
   ch = c --ch = the wrong red letter
   wrong_char += 1
  end
  
  topl = sub(fox,index,index)

  --delete word 
  if (#typed) == 1000 then
  	typed = ""
  end 
  
  --generate new text
  if index == #fox-15 then
   --fox = fox.." lorem"
   fox = fox.." "..new_word()
  end
  
 end
 
end

function _draw()
 cls() map() --draws map

 timer = mytimer() 
 --timer = flr(time())

 local left = 
  max(0,test_time-timer)
 
	print("0="..tostr(correct_char)..
 " x="..tostr(wrong_char),7)
 
	print(tostr(wpm).."wpm "
 	..tostr(acc).."%acc",40,40,11)
	
	if timer  > 0 then
	 upd_wpm()
  upd_acc()
 end
	
	-- end test
 if timer >= test_time then
  game_over = true
  if btnp(4) then
   _init(60) --press z start over
  end

  if btnp(5) then 
   _init(30)
  end
  
		return 
 end
  
 print(left,60,30, 7)
	
 print(tostr(wpm).."wpm "
 ..tostr(acc).."%acc",40,40,11)
 
 print(typed,10,20,11)
 --keyboardkey()
 
	print(fox, fox_p,50,7)
	print(typed,fox_p,50,11)
	
	keyboardkey()
	
	if lcolor == 8 then
		print(topl,63,61,lcolor)
	end

	--print(letter,60,67,lcolor)
	--print(ch,64,50,lcolor)
end
-->8
function new_letter()
	letter=chr(flr(rnd(26))+97)
	lcolor=7
end

function new_word()
	i = flr(rnd(1000))+1			
	word = eng1k[i] --word_table[i]
	return word
end

row1 = 25
row2 = 29
row3 = 33

function keyboardkey()
 spr(22,61,54) -- cursor
 spr(1,0,50) 
 spr(1,120,50)
 
 for i=1,10 do --row1
 	spr(8,row1+(-8+i*8),71)
 	spr(24,row1+(-8+i*8),79)
 end
 
 for i=1, 9 do --row2
  spr(8,row2+(-8+i*8),81)
  spr(24,row2+(-8+i*8),89)
 end
 
 for i=1, 9 do --row3
  spr(8,row3+(-8+i*8),91)
  spr(24,row3+(-8+i*8),99)
 end
 
 --spr(6,40,49)
 --spr(7,48,49)
 --spr(23,48,57)
 --spr(5,52,46)
 --spr(5,43,46,1,1,true)
end

function upd_wpm() 
	wpm = flr((correct_char/5)
	/(timer/60))	
end

function upd_acc()
 if index > 1 then 
	 acc = flr((correct_char/
	 (correct_char+wrong_char))*100)
 end
end

function mytimer()
	local t = flr(tick / 60)
	return t	
end

function reset_game()
 typed = ""
 fox = "the quick brown fox"
 fox_p = 63

 correct_char = 0
 wrong_char = 0

 wpm = 0
 acc = 100

 index = 1
 tick = 0
 timer = 0

 game_over = false

 topl = sub(fox,index,index)
end
