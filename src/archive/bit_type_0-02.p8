pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
--game_init
function init_game(x)
	cls()
	_update60 = update_game
	_draw = draw_game
	
 poke(0x5f2d,1)--enable stat(31)
 poke(0x5f2e,1)--hidden palette
 pal(9,9+122,1)
 palt(0,false)
 palt(5,true)
 music(0)
 reset_game()
 test_time = max(2,x)
 ski = true
 chs = ""
 lcolor = 7
 for i = 1,999 do stat(31) end
  
end

function update_game()
	if game_over == true then
		poke(0x5f30,0)
	 return 
	end
	
	tick += 1
	--disable pause via p or enter
	--important here for custom pause menu
	poke(0x5f30,1)
	
	if ski==true then
  ski = false
  stat(31)
  return		
	end
	
 if stat(30) then
  local c = stat(31) -- last typed character
  chs = c
  
  if c == topl then
  	typed..= c
  	index += 1
  	fox_p -= 4-- move text to left
  	correct_char += 1
  	ch = ""
  	lcolor = 7
  	
 
  --backspace detection
  elseif c == "\b" and fox_p < 63 then 
   typed = sub(typed,1,#typed-1)
   index -= 1
   fox_p += 4
   
  else  -- if wrong letter typed
   lcolor = 8
   ch = c --ch = the wrong red letter
   wrong_char += 1
   sfx(3)
  end
  
  topl = sub(fox,index,index)
  sfx(1)
  --generate new text
  if index == #fox-15 then
   --fox = fox.." lorem"
   fox = fox.." "..new_word()
  end
  
 end
end

function draw_game()
 cls() map() --draws map

 timer = mytimer() 
 --timer = flr(time())

 local left = 
  max(0,test_time-timer)
 
	print("0="..tostr(correct_char)..
 " x="..tostr(wrong_char),7)
 
	print(tostr(wpm).."wpm "
 	..tostr(acc).."%acc",40,40,11)
	
	if timer  > 0 then
	 upd_wpm()
  upd_acc()
 end
	
	-- end test
 if timer >= test_time then
  game_over = true
 	results()
  return 
 end
  
 print(left,60,30, 7)
	
 print(tostr(wpm).."wpm "
 ..tostr(acc).."%acc",40,40,11)
 
 print(typed,10,20,11)
 
	print(fox, fox_p,50,7)
	print(typed,fox_p,50,11)
		
	keyboardkey()
	keylight(chs)
	
	if lcolor == 8 then
		print(chs,63,61,lcolor)
	end

 rect(4,4,124,124,3) -- margins
end
-->8
-- custom functions

function new_word()
	i = flr(rnd(1000))+1			
	w = eng1k[i] --word_table[i]
	return w
end

rows={25,29,33}
counts={10,9,9}

function keyboardkey()
 spr(22,61,54)
 spr(1,-4,50)
 spr(1,124,50)

 local li=1

 for row=1,3 do
  local y=71+(row-1)*10

  for i=1,counts[row] do
   local x=rows[row]-8+i*8

   spr(8,x,y)
   spr(24,x,y+8)
   print(sub(letters,li,li),x+2,y+2,11)

   li+=1
  end
 end
end

letters="qwertyuiopasdfghjklzxcvbnm,."

keys = {
	{"q",27,73},{"w",35,73},{"e",43,73},{"r",51,73},{"t",59,73},
	{"y",67,73},{"u",75,73},{"i",83,73},{"o",91,73},{"p",99,73},

	{"a",31,83},{"s",39,83},{"d",47,83},{"f",55,83},{"g",63,83},
	{"h",71,83},{"j",79,83},{"k",87,83},{"l",95,83},

	{"z",35,93},{"x",43,93},{"c",51,93},{"v",59,93},
	{"b",67,93},{"n",75,93},{"m",83,93}
}

function keylight(c)
	for k in all(keys) do
  if c == k[1] then
   spr(11,k[2]-2,k[3]-2)
   print(k[1],k[2],k[3],9) 
  end 
 end

end

function upd_wpm() 
	wpm = flr((correct_char/5)
	/(timer/60))	
end

function upd_acc()
 if index > 1 then 
	 acc = flr((correct_char/
	 (correct_char+wrong_char))*100)
 end
end

function mytimer()
	local t = flr(tick / 60)
	return t	
end

function reset_game()
 typed = ""
 fox = "the quick brown fox jumps over the lazy dog"
 fox_p = 63

 correct_char = 0
 wrong_char = 0

 wpm = 0
 acc = 100

 index = 1
 tick = 0
 timer = 0

 game_over = false

 topl = sub(fox,index,index)
end

menuitem(1,"27 secodn test",function() init_game(27)
end)

function results()
	music(-1)
	
	print("60 sec:🅾️",45,60,11)
	print("30 sec:❎",45,70,11)
	print("120 sec:⬆️",41,80,11)
	
	 --press z start
 if btnp(4) then init_game(60) end
 if btnp(5) then init_game(30) end
 if btnp(2) then init_game(120) end
 
end
-->8
