pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
--8it_type
--by alchigh
function init_game(x)
	_update60=update_game
	_draw=draw_game
 poke(0x5f2d,1)--enable stat(31)
 poke(0x5f2e,1)--hidden palette
 pal(9,9+122,1)
 palt(0,false)
 palt(5,true)
 music(0)
 reset_game()
 tt=x
 to=false
 chs=""
 lcolor=7
 for i=1,99 do stat(31)end
end

function update_game()
	if gg then 
	 poke(0x5f30,0)
	 return 
	end
	tick+=1
	poke(0x5f30,1)--disable pause
 if stat(30) then
  local c=stat(31)
  chs=c
  if c==sub(fox,index,index) then
  	typed..=c
  	index+=1
  	fp-=4
  	rc+=1
  	to=false
 --backspace
  elseif c=="\b" and fp<63 then 
   typed=sub(typed,1,#typed-1)
   index-=1
   fp+=4
  else
   to=true--type o
   wc+=1
   sfx(3)
  end
  sfx(1)
  if index==#fox-15 then
   fox=fox.." "..eng1k[flr(rnd(999))+1]
  end
 end
end

function draw_game()
 cls()map()
 tmr=tick\60 
--print("0="..rc.." x="..wc)
	print(wpm.."wpm "
	..acc.."%acc",40,40,11)
	if tmr>0 then upd_stat()end
 if tmr>=tt then
  gg=true	result() return 
 end
 print(max(0,tt-tmr),60,30,7)
	print(fox,fp,50,7)
	print(typed,fp,50,11)
	kbkey()
	keyani(chs)
	if to then
		print(chs,63,61,8)
	end
 rect(5,5,123,122,3)
end
-->8
--custom functions
rows={25,29,33}
counts={10,9,9}
function kbkey()
 spr(22,61,54)
 spr(1,-2,50)
 spr(1,123,50)
 local li=1
 for r=1,3 do
  local y=71+(r-1)*10
  for i=1,counts[r] do
   local x=rows[r]-8+i*8
   spr(8,x,y)
   spr(24,x,y+8)
   print(sub(chars,li,li),x+2,y+2,11)
   li+=1
  end
 end
end
chars="qwertyuiopasdfghjklzxcvbnm,."

function keyani(c)
 local i
 for j=1,#chars do
  if c==sub(chars,j,j) then
   i=j
   break
  end
 end
 if not i then return end
 local x,y
 if i<11 then
  x=19+i*8
  y=73
 elseif i<20 then
  x=23+(i-10)*8
  y=83
 else
  x=27+(i-19)*8
  y=93
 end
 spr(11,x-2,y-2)
 print(c,x,y,9)
end

function upd_stat()
 wpm=flr((rc/5)/(tmr/60))
 if index>1 then 
	 acc=flr((rc/(rc+wc))*100)
 end
end

function reset_game()
 typed=""
 fox="the quick brown fox jumps over the lazy dog"
 fp=63
 rc=0
 wc=0
 wpm=0
 acc=100
 index=1
 tick=0
 tmr=0
 gg=false
end

function result()
 print("30 sec:❎",45,60,11)
	print("60 sec:🅾️",45,70,11)
	print("120 sec:⬆️",41,80,11)
	local t
 if btnp(5)then t=60end
 if btnp(4)then t=30end
 if btnp(2)then t=120end
 if t then init_game(t)end
end
-->8
